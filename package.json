{
  "name": "pickleball-queue",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=services/api",
    "dev:player": "npm run dev --workspace=apps/player-app",
    "dev:staff": "npm run dev --workspace=apps/staff-console",
    "dev:admin": "npm run dev --workspace=apps/admin-dashboard",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@supabase/server": "^1.5.3",
    "@supabase/supabase-js": "^2.115.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "supabase": "^2.116.0"
  }
}
